---
# Copy to inventory/group_vars/all.yml (or a group/host file) and adjust.
# Variables are per-version because control IDs differ between benchmarks.

# ---------------- RHEL 8 (CIS v4.0.0) ----------------
rhel8cis_level: 1
rhel8cis_profile: server
rhel8cis_skip_rules: []
rhel8cis_sshd_allowgroups: [wheel]

# ---------------- RHEL 9 (CIS v3.0.0) ----------------
rhel9cis_level: 1
rhel9cis_profile: server
rhel9cis_skip_rules:
  - "1.1.1.6"     # overlay - needed for podman
rhel9cis_sshd_allowgroups: [wheel]

# ---------------- RHEL 10 (CIS v1.0.1) ---------------
rhel10cis_level: 2
rhel10cis_profile: server
rhel10cis_skip_sections:
  - "1.1.2"       # partitioning handled at build time
rhel10cis_rule_5_1_20: false   # keep root SSH login on this group (PermitRootLogin)
rhel10cis_sshd_allowgroups: [wheel]
