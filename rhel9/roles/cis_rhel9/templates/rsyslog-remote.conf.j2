# Managed by Ansible - CIS remote logging
{% if rhel9cis_rsyslog_tls | bool %}
global(DefaultNetstreamDriverCAFile="{{ rhel9cis_rsyslog_tls_ca }}")
{% endif %}
*.* action(type="omfwd" target="{{ rhel9cis_rsyslog_remote_host }}" port="{{ rhel9cis_rsyslog_remote_port }}" protocol="{{ rhel9cis_rsyslog_remote_protocol }}"
{% if rhel9cis_rsyslog_tls | bool %}
           StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name"
{% endif %}
           action.resumeRetryCount="100"
           queue.type="LinkedList" queue.size="1000")
